# Contraseña de acceso a la app entera (middleware.ts). Sin ella, cualquiera
# con la URL podría gastar tu cuota gratis de IA.
ACCESS_PASSWORD=elige_una_contrasena

# Obtén tu API Key gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Opcional: cambiar el proveedor por defecto del servidor.
# Valores admitidos: gemini, openai, openrouter
#
# IMPORTANTE: openai y openrouter solo aceptan audio wav/mp3, no el audio/mp4
# nativo que graba un iPhone. La conversión a WAV la decide el NAVEGADOR según
# los ajustes personales de cada usuario (panel de ajustes de la app), no
# según este PROVIDER_ID del servidor. Si fijas aquí openai/openrouter y un
# usuario no ha configurado su propia clave en el panel de ajustes, su
# navegador seguirá enviando audio/mp4 sin convertir y el servidor rechazará
# cada petición con 415. Solo gemini es seguro como valor por defecto del
# servidor sin que cada usuario configure nada, porque acepta el audio nativo
# del iPhone. Usa openai/openrouter aquí únicamente si TODOS los usuarios van
# a configurar su propia clave (y por tanto su propio proveedor) desde el
# panel de ajustes.
# PROVIDER_ID=gemini
# PROVIDER_API_KEY=clave_del_proveedor_elegido
# PROVIDER_MODEL=modelo_concreto
